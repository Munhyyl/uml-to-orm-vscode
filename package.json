{
  "name": "uml-orm-refactor",
  "displayName": "UML to ORM Refactor",
  "description": "Bi-directional bridge between Visual UML Class Diagrams and ORM Code (Prisma, TypeORM, SQLAlchemy, Hibernate)",
  "version": "0.2.1",
  "publisher": "munkhorgil",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "uml",
    "orm",
    "prisma",
    "typeorm",
    "sqlalchemy",
    "hibernate",
    "database",
    "schema"
  ],
  "author": "M.Munkh-Orgil",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/munkhorgil/uml-orm-refactor.git"
  },
  "homepage": "https://github.com/munkhorgil/uml-orm-refactor#readme",
  "bugs": {
    "url": "https://github.com/munkhorgil/uml-orm-refactor/issues"
  },
  "files": [
    "dist/**",
    "resources/**",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "activationEvents": [
    "workspaceContains:*.orm.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "uml-orm-refactor.diagramEditor",
        "displayName": "UML Diagram Editor",
        "selector": [
          {
            "filenamePattern": "*.orm.json"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "uml-orm-refactor.openEditor",
        "title": "Open UML Diagram Editor",
        "category": "UML to ORM"
      },
      {
        "command": "uml-orm-refactor.generateCode",
        "title": "Generate ORM Code",
        "category": "UML to ORM"
      },
      {
        "command": "uml-orm-refactor.importSchema",
        "title": "Import Schema from Code",
        "category": "UML to ORM"
      },
      {
        "command": "uml-orm-refactor.exportXMI",
        "title": "Export to XMI (UML 2.5.1)",
        "category": "UML to ORM"
      },
      {
        "command": "uml-orm-refactor.importXMI",
        "title": "Import from XMI",
        "category": "UML to ORM"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "uml-orm-explorer",
          "title": "UML to ORM",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "uml-orm-explorer": [
        {
          "id": "uml-orm-refactor.projectView",
          "name": "Project",
          "icon": "resources/icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "preflight": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview.js --external:vscode --loader:.css=text",
    "watch:webview": "esbuild src/webview/index.tsx --bundle --outfile=dist/webview.js --external:vscode --loader:.css=text --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts,tsx",
    "test": "node ./dist/test/runTest.js",
    "package": "npm run preflight && npx -y node@20 $(which npx) -y @vscode/vsce@3.7.1 package",
    "publish": "npx @vscode/vsce@3.7.1 publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.0.0",
    "mocha": "^10.8.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reactflow": "^11.10.0",
    "typescript": "^5.0.0",
    "vscode-test": "^1.6.0"
  }
}
